# Bu dosyanın kopyasını ".env" adıyla oluşturup değerleri doldurun.
# .env dosyası gizlidir; kimseyle paylaşmayın ve GitHub'a yüklemeyin.

# Google AI Studio'dan alınan ücretsiz anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Kullanılacak model. Çalışmazsa AI Studio'da görünen güncel ücretsiz model adını yazın.
GEMINI_MODEL=gemini-flash-latest

# Pexels ücretsiz API anahtarı: https://www.pexels.com/api/
PEXELS_API_KEY=

# Pexels yerine Pixabay da kullanılabilir (ikisi birden doluysa Pexels kullanılır):
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Türkçe seslendirme sesi (tr-TR-AhmetNeural erkek, tr-TR-EmelNeural kadın)
TTS_SES=tr-TR-AhmetNeural
